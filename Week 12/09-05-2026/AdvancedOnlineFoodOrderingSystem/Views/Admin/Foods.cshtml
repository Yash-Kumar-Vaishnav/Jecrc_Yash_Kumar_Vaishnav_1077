@model IEnumerable<OnlineFoodOrderingSystem.Models.FoodItem>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>

<div class="container mt-5">

    <h1>Food Management</h1>

    <a href="/Admin/CreateFood"
       class="btn btn-success mb-3">
       Add Food
    </a>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>

                <td>@item.Price</td>

                <td>

                    <a href="/Admin/EditFood/@item.Id"
                       class="btn btn-warning">
                       Edit
                    </a>

                    <a href="/Admin/DeleteFood/@item.Id"
                       class="btn btn-danger">
                       Delete
                    </a>

                </td>
            </tr>
        }

        </tbody>

    </table>

</div>