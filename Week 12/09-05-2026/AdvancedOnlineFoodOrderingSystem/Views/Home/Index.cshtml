@model IEnumerable<OnlineFoodOrderingSystem.Models.FoodItem>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet"/>

<style>

    body{
        background:#f4f4f4;
        font-family:'Segoe UI',sans-serif;
    }

    /* NAVBAR */

    .navbar-custom{
        background: linear-gradient(to right,#ff512f,#dd2476);
        padding:18px;
        border-radius:18px;
        box-shadow:0 5px 20px rgba(0,0,0,0.2);
    }

    .navbar-brand{
        color:white !important;
        font-size:32px;
        font-weight:bold;
    }

    .nav-btn{
        border-radius:12px;
        font-weight:bold;
        padding:10px 18px;
    }

    /* HERO */

    .hero{
        background: linear-gradient(to right,#ff512f,#dd2476);
        color:white;
        padding:90px 40px;
        border-radius:30px;
        margin-bottom:50px;
        text-align:center;
        box-shadow:0 10px 30px rgba(0,0,0,0.2);
    }

    .hero h1{
        font-size:65px;
        font-weight:bold;
    }

    .hero p{
        font-size:22px;
    }

    /* SEARCH */

    .search-box{
        margin-top:-25px;
        margin-bottom:50px;
    }

    .search-input{
        border-radius:15px 0 0 15px;
        padding:15px;
        border:none;
    }

    .search-btn{
        border-radius:0 15px 15px 0;
        background:#111;
        color:white;
        border:none;
        padding:15px 25px;
    }

    /* FOOD CARD */

    .food-card{
        border:none;
        border-radius:25px;
        overflow:hidden;
        transition:0.4s;
        background:white;
        box-shadow:0 5px 20px rgba(0,0,0,0.1);
    }

    .food-card:hover{
        transform:translateY(-10px) scale(1.02);
    }

    .food-img{
        height:250px;
        width:100%;
        object-fit:cover;
    }

    .card-body{
        padding:25px;
    }

    .card-title{
        font-weight:bold;
        font-size:28px;
    }

    .food-desc{
        min-height:55px;
        color:#777;
    }

    .price{
        color:#ff512f;
        font-size:28px;
        font-weight:bold;
    }

    .rating{
        color:#ffc107;
    }

    .btn-cart{
        background: linear-gradient(to right,#ff512f,#dd2476);
        color:white;
        border:none;
        border-radius:15px;
        width:100%;
        padding:12px;
        font-weight:bold;
        transition:0.3s;
    }

    .btn-cart:hover{
        opacity:0.9;
        color:white;
    }

</style>

<div class="container mt-4">

    <!-- NAVBAR -->

    <div class="navbar navbar-custom mb-4">

        <div class="container-fluid">

            <span class="navbar-brand">
                🍔 FoodExpress
            </span>

            <div class="d-flex gap-2">

                <a href="/Cart"
                   class="btn btn-light nav-btn position-relative">

                   <i class="fa-solid fa-cart-shopping"></i>
                   Cart

                   <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                       New
                   </span>

                </a>

                <a href="/Order/Orders"
                   class="btn btn-dark nav-btn">

                   <i class="fa-solid fa-box"></i>
                   Orders

                </a>

            </div>

        </div>

    </div>

    <!-- HERO -->

    <div class="hero">

        <h1>
            Delicious Food Delivered Fast 🚀
        </h1>

        <p class="mt-3">
            Fresh • Fast • Tasty
        </p>

    </div>

    <!-- SEARCH -->

    <div class="search-box">

        <form method="get">

            <div class="input-group">

                <input type="text"
                       name="search"
                       class="form-control form-control-lg search-input"
                       placeholder="Search burgers, pizza, pasta..." />

                <button class="search-btn">

                    <i class="fa-solid fa-magnifying-glass"></i>

                </button>

            </div>

        </form>

    </div>

    <!-- FOOD LIST -->

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card food-card">

                    <img src="https://source.unsplash.com/600x400/?food,@item.Name"
                         class="food-img"/>

                    <div class="card-body">

                        <h3 class="card-title">
                            @item.Name
                        </h3>

                        <div class="rating mb-2">

                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>

                            <span class="text-dark ms-2">
                                4.5
                            </span>

                        </div>

                        <p class="food-desc">
                            @item.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="price">
                                ₹@item.Price
                            </span>

                            <span class="badge bg-success">
                                Available
                            </span>

                        </div>

                        <a href="/Cart/AddToCart/@item.Id"
                           class="btn btn-cart mt-4">

                           <i class="fa-solid fa-cart-plus"></i>
                           Add To Cart

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>